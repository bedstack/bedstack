{
  "name": "bedstack",
  "title": "Bedstack",
  "description": "Bun + ElysiaJS + Drizzle = the stack you don't want to sleep on",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --ui tui",
    "typecheck": "turbo run typecheck",
    "typegen": "turbo run typegen",
    "www": "turbo run dev --filter=www",
    "fix": "bun bin/fix.js",
    "fix:unsafe": "bun bin/fix.js --unsafe",
    "check": "biome check && manypkg check",
    "check:errors": "biome check --diagnostic-level=error",
    "clean": "turbo run clean && rimraf dist node_modules",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@manypkg/cli": "0.25.1",
    "all-contributors-cli": "6.26.1",
    "rimraf": "6.1.3",
    "turbo": "2.9.8",
    "typescript": "5.9.3"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ],
  "packageManager": "bun@1.3.2",
  "engines": {
    "bun": "^1.3.2"
  },
  "workspaces": [
    "apps/*"
  ]
}
